rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /slambook_entries/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /nostalgia_memories/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /favorite_tracks/{id} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
